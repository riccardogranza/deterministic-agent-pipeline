# OpenAI-Compatible Local or Cloud LLM Endpoint
# Supports Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), vLLM, or OpenAI
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=ollama-local
LLM_TIMEOUT_MS=15000

# SQLite WAL Audit Database Path
AUDIT_DB_PATH=./data/pipeline-audit.sqlite
